{
  "name": "dune-update-action",
  "description": "GitHub Actions For Dune Query Updates",
  "version": "0.0.0",
  "author": "Ben Smith (@bh2smith)",
  "type": "module",
  "private": false,
  "bin": {
    "dune-update": "./dist/cli.js"
  },
  "homepage": "https://github.com/bh2smith/dune-update#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bh2smith/dune-update.git"
  },
  "bugs": {
    "url": "https://github.com/bh2smith/dune-update/issues"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "TypeScript"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "bun run format:write && bun run package",
    "ci-test": "bunx --bun vitest run",
    "format:write": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check .",
    "lint": "bunx --bun eslint .",
    "package": "bun build src/index.ts src/cli.ts --outdir dist --target node --bundle --sourcemap=external",
    "test": "bunx --bun vitest run",
    "check": "bun run format:check && bun run lint && bun run test"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@duneanalytics/client-sdk": "^0.4.4",
    "diff": "^9.0.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
